type CurveStyle {
  bend: Number = 0.75
  peak: Number = 0.5
}

type ElbowStyle {
  turn: Number = 1
  roundness: Number = 0.25
}

type BendStyle {
  balance: Number = 0.5
  tension: Number = 0.2
}

type ArcStyle {
  gap: Number = 0.6
}

type UTurnStyle {
  depth: Number = 0.5
  spread: Number = 1
}

type LoopStyle {
  size: Number = 0.35
  position: Number = 0.475
  exit: Number = 0.2
}

type WaveStyle {
  amplitude: Number = 0.65
  balance: Number = 0.5
}

type ZigZagStyle {
  amplitude: Number = 0.35
  skew: Number = 0
}

type StepStyle {
  first: Number = 0.28
  second: Number = 0.65
  level: Number = 0.55
}

type BlockStyle {
  shaft: Number = 0.36
  head: Number = 0.32
}

type ChevronStyle {
